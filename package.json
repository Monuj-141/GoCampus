{
  "name": "connectcampus-workspace",
  "version": "1.0.0",
  "description": "Full-Stack Campus Management Platform Workspace",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../ConnectCampus && npm install",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd ConnectCampus && npm run dev",
    "seed": "cd server && npm run seed",
    "build": "cd ConnectCampus && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
