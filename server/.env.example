# Server Port
PORT=5000

# MongoDB URI (Supports MongoDB Atlas or local MongoDB connection)
# Leave as local or memory fallback if running locally
MONGODB_URI=mongodb://127.0.0.1:27017/connectcampus

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Cloudinary Configuration (for storing profile photos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# or CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Email / SMTP Configuration (for verification & password-reset emails)
# Leave blank in local dev — emails will be printed to the server console instead of sent.
# Example for Gmail: use an App Password, EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="ConnectCampus <no-reply@connectcampus.edu>"

# Base URL of the deployed frontend (used to build email links)
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development
